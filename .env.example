# Environment
ENVIRONMENT=local

# Downstream service URLs
IQS_URL=http://localhost:8003
RETRIEVAL_URL=http://localhost:8002
LLM_GATEWAY_URL=http://localhost:8001

# Conversation Store (local → SQLite, shared with IQS)
SQLITE_DB_PATH=../iqs-service/data/conversations.db

# Production Postgres (same DB as IQS)
POSTGRES_DSN=postgresql://user:pass@localhost:5432/conversations

# History window (same as IQS for consistency — LLD TBD-RO-10)
HISTORY_WINDOW_SIZE=5

# Prompt template
PROMPT_TEMPLATE_VERSION=v1
